{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "src/**/*",
    "vite.config.ts",
    "build_module.ts"
  ],
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "esnext",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "fvtt-types"
    ]
  }
}